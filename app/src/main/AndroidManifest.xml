<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IWatchMeAndroid"
        android:usesCleartextTraffic="true"
        tools:targetApi="S">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.IWatchMeAndroid.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".demo.renderengine.RenderEngineDemoActivity"
            android:exported="true"
            android:label="RenderEngine Demo"
            android:theme="@style/Theme.IWatchMeAndroid" />

        <!-- Cocos shell demo: game container Activity runs in :cocos_game,
             talking to a Messenger Service in the main process. Mirrors the
             original ggr `:ggr_game` process + GameMessageService split. -->
        <service
            android:name="com.iwatchme.cocosshell.service.GameMessageService"
            android:exported="false" />
        <activity
            android:name=".demo.cocosshell.CocosGameActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:label="Cocos Game"
            android:process=":cocos_game"
            android:theme="@style/Theme.IWatchMeAndroid" />

        <!-- Shadow 插件壳子 Activity / Service / Provider 全部在 :host-shadow library manifest 里
             声明，AGP 在 manifest merger 阶段自动合并到这里。需要调整壳子数量或属性见
             host-shadow/src/main/AndroidManifest.xml -->
    </application>

</manifest>
