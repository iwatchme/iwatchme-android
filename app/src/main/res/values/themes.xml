<resources >
    <style name="Theme.JetpackStarter" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/forest_500</item>
        <item name="colorPrimaryVariant">@color/forest_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/clay_200</item>
        <item name="colorSecondaryVariant">@color/clay_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.JetpackStarter.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.JetpackStarter</item>
    </style>
</resources>
