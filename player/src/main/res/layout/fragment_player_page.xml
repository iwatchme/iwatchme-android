<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- 播放器区域 -->
    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false" />

        <!-- 手势 surface：吃所有 MotionEvent，PlayerGestureSurfaceUIComponent 负责挂 listener。
             置于 playerView 之上、overlay 之下：fullscreen 按钮（在 overlay 内）能优先消费点击；
             空白区域 touch 落到本层，PlayerView 的 controller 已 use_controller=false 关闭。 -->
        <FrameLayout
            android:id="@+id/gestureSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- loading / error / 手势 indicator overlay 动态添加到这里 -->
        <FrameLayout
            android:id="@+id/playerOverlayContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 底部播放控制栏：[SeekBar][时间][全屏按钮] —— 标准播放器布局。
             SeekBar 的可拖动属性会拦截手势 surface 的横滑事件，但只在底部一行；
             其他区域横滑仍能落到 gestureSurface 触发 seek 手势。 -->
        <LinearLayout
            android:id="@+id/playbackControlBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#66000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <SeekBar
                android:id="@+id/playbackSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/playbackTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:text="00:00 / 00:00" />

            <TextView
                android:id="@+id/fullscreenButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- 当前合集标题（点击切换合集，触发 BizScope 整链重建） -->
    <TextView
        android:id="@+id/currentTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:textColor="#333333"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:text="等待加载..."
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playerContainer" />

    <!-- 业务专属信息（UGC: UP主名 / OGV: 季度 + VIP 标签）—— 数据由当前 BizScope 决定 -->
    <TextView
        android:id="@+id/bizInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textSize="12sp"
        android:background="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/currentTitle" />

    <!-- 当前播放集（EpisodeScope 数据，反映正在播放的样片名） -->
    <TextView
        android:id="@+id/episodeTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:textColor="#FB7299"
        android:textSize="13sp"
        android:background="#FFFFFF"
        android:text=""
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bizInfo" />

    <!-- 视频列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/videoList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/episodeTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>
